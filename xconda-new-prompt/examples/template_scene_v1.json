{
  "schema": "xconda-scene-v1",
  "sceneId": "S[씬번호]",
  "title": "[씬 제목]",
  "model": "Seedance 2.5",

  "room": {
    "id": "[room_id]",
    "kind": "[공간 종류, 예: 사무실]",
    "name": "[공간 이름]",
    "center": [0.0, 0.0],
    "width": 8.0,
    "depth": 6.0,
    "height": 2.7,
    "obstacles": [
      { "id": "[가구id]", "kind": "furniture",
        "center": [0.0, 0.0], "width": 1.0, "depth": 1.0, "hdg": 0, "blocksSight": false }
    ],
    "portals": [
      { "id": "[문id]", "kind": "doorway",
        "center": [0.0, 0.0], "width": 0.9, "hdg": 0, "state": "open" }
    ]
  },

  "refs": {
    "characters": [
      { "tag": "@Image1", "id": "[actor_id_1]", "name": "[인물1 한글명]" },
      { "tag": "@Image2", "id": "[actor_id_2]", "name": "[인물2 한글명]" }
    ],
    "backgrounds": [
      { "tag": "@Image[N]", "name": "[배경 이름]", "refImage": "[파일명.jpg]" }
    ],
    "props": [
      { "tag": "@Image[N]", "name": "[소품 이름]", "refImage": "[파일명.png]",
        "note": "[형태·소재·잠금 메모, 선택]" }
    ],
    "audio": [
      { "tag": "@Audio1", "name": "[오디오 내용 설명]",
        "note": "[출처·구간·확인 필요 메모, 선택]" }
    ],
    "video": []
  },

  "parts": [
    {
      "partId": "A",
      "title": "[파트 제목]",
      "duration": 0.0,
      "mode": "멀티컷",
      "appears": ["[actor_id_1]", "[actor_id_2]"],
      "usesRefs": ["@Image1", "@Image2", "@Audio1"],

      "blocking": {
        "[actor_id_1]": { "x": 0, "y": 0, "angle": 0, "pose": "서다", "path": [] },
        "[actor_id_2]": { "x": 0, "y": 0, "angle": 0, "pose": "서다", "path": [] }
      },

      "cameras": [
        { "cutRef": "CUT[씬-1]", "x": 0, "y": 0, "target": [0, 0],
          "fov": 47, "shotSize": "미디엄", "subject": "[actor_id_1]", "angle": 0 }
      ],

      "prompt": {
        "meta": { "ver": "v1", "level": "LEVEL 2" },
        "blocks": [
          { "n": "01", "t": "장면 컨텍스트", "tEn": "SCENE CONTEXT", "ko": "[한국어]", "en": "[English]" },
          { "n": "02", "t": "레퍼런스 / 범례", "tEn": "ACTIVE REFERENCES", "ko": "[한국어]", "en": "[English]" },
          { "n": "03", "t": "시네마틱 셋업", "tEn": "LOCATION MAP AND LIGHTING", "ko": "[한국어]", "en": "[English]" },
          { "n": "04", "t": "옵틱스·카메라·포맷", "tEn": "FORMAT MODE / OPTICS / CAMERA", "ko": "[한국어]", "en": "[English]" },
          { "n": "05", "t": "텍스트 락·소품·의상", "tEn": "PROP AND WARDROBE LOCK", "ko": "[한국어]", "en": "[English]" },
          { "n": "06", "t": "퍼포먼스·상태 오버레이", "tEn": "PERFORMANCE", "ko": "[한국어]", "en": "[English]" },
          { "n": "07", "t": "배경 인물 명세", "tEn": "BACKGROUND CAST", "ko": "[한국어]", "en": "[English]" },
          { "n": "08", "t": "초 단위 타임라인", "tEn": "ACTION TIMELINE", "cuts": true,
            "headKo": "[초 단위 타임라인] 대사는 각 컷 안에 '대사 — 화자: {대사}' 라벨 줄로 표기한다. 마이크로 파즈(0.5~1초)를 대사 직후에 둔다.",
            "headEn": "[ACTION TIMELINE] Dialogue is labeled inside each cut as 'Dialogue — Speaker: {line}'. A 0.5-1s micro-pause follows each line of dialogue." },
          { "n": "09", "t": "스타일 & 출력", "tEn": "STYLE / OUTPUT SETTINGS", "ko": "[한국어]", "en": "[English]" },
          { "n": "10", "t": "포지티브 락", "tEn": "POSITIVE LOCKS", "ko": "[한국어]", "en": "[English]" }
        ],
        "cuts": [
          {
            "tc": "[시작]-[끝]초",
            "lb": "CUT[씬-1] · [샷사이즈] [화각]°",
            "dlg": "",
            "speaker": "",
            "dlgPlain": "",
            "ko": "[타임코드 — CUT번호. 첫 프레임 공간 — ...액션... (대사 있으면 다음 줄에 대사 — 화자: {대사})]",
            "en": "[timecode — CUT#. FIRST FRAME SPACE — ...action... (if dialogue, next line: Dialogue — Speaker: {line})]"
          }
        ]
      },

      "_comment_보드_익스포트_확장_필드": "아래 3종은 기존 blocking/prompt를 대체하지 않는 추가 필드입니다(v9.10). 실제 파일에는 이 _comment 키를 넣지 않습니다.",

      "dialogueSchedule": [
        { "actorId": "[actor_id 또는 null]", "speakerName": "[화자명]",
          "line": "[대사 원문, 중괄호 제외]", "start": 0.0, "end": 0.0 }
      ],

      "actions": [
        { "cutRef": "CUT[씬-1]", "actorId": "[actor_id 또는 null]",
          "actionType": "[동사형 짧은 태그, 예: approach_speak]",
          "start": 0.0, "end": 0.0, "text": "[한 줄 요약]" }
      ],

      "blockingBoard": [
        { "actorId": "[actor_id_1]", "x": 0, "y": 0, "angle": 0, "pose": "서다", "path": [] }
      ]
    }
  ]
}
